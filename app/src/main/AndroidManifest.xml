<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Запись голоса: системное распознавание и встроенный GigaAM. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <!-- SpeechRecognizer.isRecognitionAvailable видит сервис распознавания только с этим запросом (API 30+) -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".TratyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Traty">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Панель быстрой записи: плитка и виджет открывают её, главное приложение не запускается -->
        <activity
            android:name=".ui.capture.CaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.Traty.Capture"
            android:launchMode="singleInstance"
            android:taskAffinity="ru.my.traty.capture"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".widget.TratyWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/traty_widget_info" />
        </receiver>

        <service
            android:name=".tile.VoiceTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_mic"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
